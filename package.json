{
  "name": "stockando-desktop",
  "version": "0.0.1",
  "description": "An Electron application with React and TypeScript",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "lint": "oxlint",
    "format": "oxlint --fix && oxfmt --write",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:fresh": "tsx scripts/migrate.ts --fresh",
    "postinstall": "electron-rebuild -o better-sqlite3"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nfewizard/danfe": "^1.0.3",
    "@nfewizard/nfce": "^1.0.4",
    "@nfewizard/shared": "^1.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.3.9",
    "fastify": "^5.10.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "nfewizard-io": "^1.1.1",
    "react-aria-components": "^1.19.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "4.2.0",
    "@nfewizard/types": "^1.0.7",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-hotkeys-devtools": "^0.7.0",
    "@tanstack/react-pacer-devtools": "^0.7.1",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.13.1"
}
